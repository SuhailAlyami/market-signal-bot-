//@version=6
indicator("Suhail Hunter | Price-only research v1", overlay=true, max_labels_count=100)
if syminfo.tickerid != "CAPITALCOM:SPX500" or not chart.is_standard or not timeframe.isminutes or timeframe.multiplier != 1
    runtime.error("Use standard 1-minute CAPITALCOM:SPX500. RESEARCH_ONLY, not cash SPX.")
const int START = timestamp("2026-10-20T00:00:00+03:00")
const int END = timestamp("2026-10-27T00:00:00+03:00")
priorATR = ta.sma(ta.tr(true)[1],20)
h5 = ta.highest(high[1],5)
l5 = ta.lowest(low[1],5)
width3 = ta.highest(high[1],3)-ta.lowest(low[1],3)
barRange = high-low
ohlcOK = open > 0 and low > 0 and high >= math.max(open,close) and low <= math.min(open,close)
valid = ta.sma(ohlcOK ? 1.0 : 0.0,31) == 1 and ta.sma(time-time[1] == 60000 ? 1.0 : 0.0,30) == 1 and priorATR > 0 and h5 > l5
inside = close <= h5 and close >= l5
readyUp = valid and width3 <= 1.5*priorATR and barRange <= priorATR and inside and h5-close <= 0.25*priorATR and close > open and close > close[1]
readyDown = valid and width3 <= 1.5*priorATR and barRange <= priorATR and inside and close-l5 <= 0.25*priorATR and close < open and close < close[1]
sweepUp = high > h5
sweepDown = low < l5
closeFraction = barRange > 0 ? (close-low)/barRange : 0.5
failUp = valid and barRange <= 2*priorATR and sweepDown and not sweepUp and inside and close > open and closeFraction >= 0.60
failDown = valid and barRange <= 2*priorATR and sweepUp and not sweepDown and inside and close < open and closeFraction <= 0.40
m1 = readyUp and not readyDown ? 1 : readyDown and not readyUp ? -1 : 0
m2 = failUp and not failDown ? 1 : failDown and not failUp ? -1 : 0
baseline = valid ? (close > open ? 1 : close < open ? -1 : 0) : 0
dayKSA = dayofmonth(time_close,"Asia/Riyadh")
selectedDay = dayKSA == 20 ? 0 : dayKSA == 21 ? 1 : dayKSA == 22 ? 2 : dayKSA == 23 ? 3 : dayKSA == 26 ? 4 : -1
var pendingSlot = array.new_int(3,0)
var completedBars = array.new_int(5,0)
var directions = array.new_int(3,0)
var expected = array.new_int(3,0)
var steps = array.new_int(3,0)
var entries = array.new_float(3,na)
var scales = array.new_float(3,na)
var lastDecision = array.new_int(3,0)
var signals = array.new_int(15,0)
var targets = array.new_int(15,0)
var stops = array.new_int(15,0)
var timeouts = array.new_int(15,0)
var ambiguous = array.new_int(15,0)
var gaps = array.new_int(15,0)
var timeoutPoints = array.new_float(15,0)
var int loadedFrom = time
var int loadedTo = time
firedM1 = false
firedM2 = false
if barstate.isconfirmed
    loadedTo := time_close
    if selectedDay >= 0 and time_close >= START and time_close < END
        array.set(completedBars,selectedDay,array.get(completedBars,selectedDay)+1)
    for model = 0 to 2
        wasPending = array.get(directions,model) != 0
        if wasPending
            scoreSlot = array.get(pendingSlot,model)
            sign = array.get(directions,model)
            if time != array.get(expected,model) or not ohlcOK
                array.set(gaps,scoreSlot,array.get(gaps,scoreSlot)+1)
                array.set(directions,model,0)
            else
                if array.get(steps,model) == 0
                    array.set(entries,model,open)
                entry = array.get(entries,model)
                scale = array.get(scales,model)
                targetPrice = entry+sign*scale
                stopPrice = entry-sign*0.75*scale
                targetHit = sign == 1 ? high >= targetPrice : low <= targetPrice
                stopHit = sign == 1 ? low <= stopPrice : high >= stopPrice
                count = array.get(steps,model)+1
                array.set(steps,model,count)
                array.set(expected,model,time+60000)
                if targetHit and stopHit
                    array.set(ambiguous,scoreSlot,array.get(ambiguous,scoreSlot)+1)
                    array.set(directions,model,0)
                else if targetHit
                    array.set(targets,scoreSlot,array.get(targets,scoreSlot)+1)
                    array.set(directions,model,0)
                else if stopHit
                    array.set(stops,scoreSlot,array.get(stops,scoreSlot)+1)
                    array.set(directions,model,0)
                else if count >= 10
                    array.set(timeouts,scoreSlot,array.get(timeouts,scoreSlot)+1)
                    array.set(timeoutPoints,scoreSlot,array.get(timeoutPoints,scoreSlot)+sign*(close-entry))
                    array.set(directions,model,0)
        direction = model == 0 ? m1 : model == 1 ? m2 : baseline
        if selectedDay >= 0 and not wasPending and valid and direction != 0 and time_close >= START and time_close < END and time_close-array.get(lastDecision,model) >= 600000
            slot = selectedDay*3+model
            array.set(pendingSlot,model,slot)
            array.set(directions,model,direction)
            array.set(expected,model,time_close)
            array.set(steps,model,0)
            array.set(entries,model,na)
            array.set(scales,model,priorATR)
            array.set(lastDecision,model,time_close)
            array.set(signals,slot,array.get(signals,slot)+1)
            firedM1 := firedM1 or model == 0
            firedM2 := firedM2 or model == 1
plotshape(firedM1,title="Range readiness research",text="RANGE",style=shape.circle,location=location.belowbar,color=color.aqua,size=size.tiny)
plotshape(firedM2,title="Failed break research",text="FAILED",style=shape.circle,location=location.abovebar,color=color.orange,size=size.tiny)
var table summary = table.new(position.bottom_right,10,17)
if barstate.islast
    for col = 0 to 9
        header = col == 0 ? "OCT / MODEL" : col == 1 ? "Bars" : col == 2 ? "N" : col == 3 ? "Target" : col == 4 ? "Stop" : col == 5 ? "Timeout" : col == 6 ? "Both" : col == 7 ? "Gap" : col == 8 ? "Pending" : "Timeout avg"
        table.cell(summary,col,0,header,text_color=color.white,bgcolor=color.black)
    for slot = 0 to 14
        dayIndex = int(math.floor(slot/3))
        model = slot%3
        dateName = dayIndex == 0 ? "20" : dayIndex == 1 ? "21" : dayIndex == 2 ? "22" : dayIndex == 3 ? "23" : "26"
        modelName = model == 0 ? "RANGE" : model == 1 ? "FAILED" : "BODY"
        table.cell(summary,0,slot+1,dateName+" "+modelName,text_color=color.white,bgcolor=color.black)
        table.cell(summary,1,slot+1,str.tostring(array.get(completedBars,dayIndex)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,2,slot+1,str.tostring(array.get(signals,slot)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,3,slot+1,str.tostring(array.get(targets,slot)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,4,slot+1,str.tostring(array.get(stops,slot)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,5,slot+1,str.tostring(array.get(timeouts,slot)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,6,slot+1,str.tostring(array.get(ambiguous,slot)),text_color=color.white,bgcolor=color.black)
        table.cell(summary,7,slot+1,str.tostring(array.get(gaps,slot)),text_color=color.white,bgcolor=color.black)
        pending = array.get(directions,model) != 0 and array.get(pendingSlot,model) == slot ? 1 : 0
        table.cell(summary,8,slot+1,str.tostring(pending),text_color=color.white,bgcolor=color.black)
        avgTimeout = array.get(timeouts,slot) > 0 ? array.get(timeoutPoints,slot)/array.get(timeouts,slot) : na
        table.cell(summary,9,slot+1,str.tostring(avgTimeout,"#.##"),text_color=color.white,bgcolor=color.black)
    table.cell(summary,0,16,"NOT_READY",text_color=color.white,bgcolor=color.black)
    table.cell(summary,1,16,"CFD path",text_color=color.white,bgcolor=color.black)
    table.cell(summary,2,16,"No P&L",text_color=color.white,bgcolor=color.black)
    table.cell(summary,3,16,str.format_time(loadedFrom,"MM-dd HH:mm","Asia/Riyadh"),text_color=color.white,bgcolor=color.black)
    table.cell(summary,4,16,str.format_time(loadedTo,"MM-dd HH:mm","Asia/Riyadh"),text_color=color.white,bgcolor=color.black)
